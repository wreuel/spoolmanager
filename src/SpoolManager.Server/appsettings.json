{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "MySQL": "MYSQL_DATABASE_STRING",
    "SQLServer": "SQL_SERVER_DATABASE_STRING"
  },
  "Jwt": {
    "Issuer": "JWT_ISSUER",
    "Audience": "JWT_AUDIENCE",
    "Key": "JWT_KEY"
  },
  "DatabaseProvider": "SqlServer"
}